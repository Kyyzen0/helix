            "value": "Écrit la géométrie du nœud affiché dans la vue 3D dans un fichier OBJ."
          }
        }
      }
    },
    "Points: the places in space that make up the shape.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points: the places in space that make up the shape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points : les emplacements dans l’espace qui composent la forme."
          }
        }
      }
    },
    "Vertices: the corners of the faces. A point shared by several faces has one vertex for each.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertices: the corners of the faces. A point shared by several faces has one vertex for each."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommets : les coins des faces. Un point partagé par plusieurs faces a un sommet pour chacune."
          }
        }
      }
    },
    "Faces: the polygons that cover the shape.": {
      "extractionState": "manual",
      "localizations": {
