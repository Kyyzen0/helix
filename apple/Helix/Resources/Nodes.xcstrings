    "param.helix::duplicate.transform_order.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The order a copy passes through the scale, the rotation, and the translation. Scale Rotate Translate turns a copy on the spot before moving it, while Translate Rotate Scale swings it around the origin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ordre dans lequel une copie subit l’échelle, la rotation et la translation. Échelle, rotation, translation fait tourner une copie sur place avant de la déplacer, tandis que Translation, rotation, échelle la fait pivoter autour de l’origine."
          }
        }
      }
    },
