    "node.helix::attributeNoise.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roughens the geometry by pushing its points along their normals with noise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend la géométrie irrégulière en poussant ses points le long de leurs normales avec du bruit."
          }
        }
      }
    },
    "node.helix::attributeNoise.input.0": {
