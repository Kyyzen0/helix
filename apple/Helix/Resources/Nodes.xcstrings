    "param.helix::skeletonPose.clip.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name of the clip to play. Empty plays the first clip of the skeleton. geometry_summary lists the clips of a skeleton with their length, and the import reports them when it reads the file. A name the skeleton does not have is an error that lists the ones it has."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du clip à lire. Vide, il lit le premier clip du squelette. geometry_summary liste les clips d’un squelette avec leur durée, et l’import les signale à la lecture du fichier. Un nom que le squelette n’a pas provoque une erreur qui liste ceux qu’il a."
          }
        }
      }
    },
    "param.helix::skeletonPose.speed.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse"
          }
        }
      }
    },
    "param.helix::skeletonPose.speed.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How fast the clip plays, as a multiple of the scene time. 2 plays it twice as fast, 0 holds it still on the frame the offset gives, and a negative speed plays it backward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de lecture du clip, en multiple du temps de la scène. 2 le lit deux fois plus vite, 0 le fige sur l’image donnée par le décalage, et une vitesse négative le lit à l’envers."
          }
        }
      }
    },
    "param.helix::skeletonPose.offset.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décalage"
          }
        }
      }
    },
    "param.helix::skeletonPose.offset.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seconds added to the clip time (the scene time multiplied by the speed). A positive offset starts the clip part way through."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secondes ajoutées au temps du clip (le temps de la scène multiplié par la vitesse). Un décalage positif démarre le clip en cours de route."
          }
        }
      }
    },
    "param.helix::skeletonPose.loop.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boucle"
          }
        }
      }
    },
    "param.helix::skeletonPose.loop.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the skeleton does when the clip time leaves the clip. Loop starts it over, Hold stays on the first or the last pose, and Once plays it one time and then returns to the rest pose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait le squelette quand le temps du clip sort du clip. Boucle le relance, Maintenir reste sur la première ou la dernière pose, et Une fois, puis repos le joue une fois puis revient à la pose de repos."
          }
        }
      }
    },
    "option.helix::skeletonPose.loop.loop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boucle"
          }
        }
      }
    },
    "option.helix::skeletonPose.loop.hold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir"
          }
        }
      }
    },
    "option.helix::skeletonPose.loop.once": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once, then rest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois, puis repos"
          }
        }
      }
    },
