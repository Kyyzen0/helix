{
  "sourceLanguage": "en",
  "strings": {
    "node.helix::attributeCreate.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribute Create"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création d’attribut"
          }
        }
      }
    },
    "node.helix::attributeCreate.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a named piece of data with a fixed value to the geometry, without changing its shape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute à la géométrie une donnée nommée, avec une valeur fixe, sans changer sa forme."
          }
        }
      }
    },
    "node.helix::attributeCreate.input.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometry"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géométrie"
          }
        }
      }
    },
