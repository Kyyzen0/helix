      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kind of value the attribute stores. A vector gets separate noise on each axis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type de valeur que l’attribut stocke. Un vecteur reçoit un bruit distinct sur chaque axe."
