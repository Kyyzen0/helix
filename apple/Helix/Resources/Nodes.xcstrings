    "param.helix::normal.attachTo.tooltip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether each point gets one normal shared by every face meeting there, or each vertex gets its own so creases can stay sharp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si chaque point reçoit une seule normale partagée par toutes les faces qui s’y rejoignent, ou si chaque sommet a la sienne pour que les arêtes restent vives."
          }
        }
      }
    },
