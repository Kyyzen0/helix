      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The elements to write the value on. Accepts a selection or a group name. Leave it empty to write on everything."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sur lesquels écrire la valeur. Accepte une sélection ou un nom de groupe. Laissez vide pour écrire sur tout."
