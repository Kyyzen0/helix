      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the rim points between the caps and the side, so the cylinder is one joined surface. Turn this off to give the caps their own points, keeping the edge between the cap and the side sharp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage les points du bord entre les fonds et le côté, pour que le cylindre forme une seule surface continue. Désactivez pour donner aux fonds leurs propres points et garder vive l’arête entre le fond et le côté."
          }
        }
      }
    },
