{
  "sourceLanguage": "en",
  "strings": {
    "The skeleton has no clip named '%@'. It has: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skeleton has no clip named '%@'. It has: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le squelette n’a pas de clip nommé « %1$@ ». Clips disponibles : %2$@."
          }
        }
      }
    },
    "Joint %@ has a parent index that is not a joint of the skeleton.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joint %@ has a parent index that is not a joint of the skeleton."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’articulation %@ a un parent qui n’est pas une articulation du squelette."
          }
        }
      }
    },
    "The parents of the joints form a loop, so the skeleton has no root to pose from.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parents of the joints form a loop, so the skeleton has no root to pose from."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parents des articulations forment une boucle : le squelette n’a pas de racine d’où partir."
          }
        }
      }
    },
    "Connect a skeleton to the input: the second output of a Geometry Import node reading a rigged file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a skeleton to the input: the second output of a Geometry Import node reading a rigged file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez un squelette à l’entrée : la seconde sortie d’un nœud Import de géométrie qui lit un fichier rigué."
          }
        }
      }
    },
    "The input is not a skeleton: it has no joint_parent and rest_local point attributes. Use the second output of a Geometry Import node that reads a rigged file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The input is not a skeleton: it has no joint_parent and rest_local point attributes. Use the second output of a Geometry Import node that reads a rigged file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée n’est pas un squelette : elle n’a pas les attributs de point joint_parent et rest_local. Utilisez la seconde sortie d’un nœud Import de géométrie qui lit un fichier rigué."
          }
        }
      }
    },
    "Connect the posed skeleton to the second input: the output of a Skeleton Pose node.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the posed skeleton to the second input: the output of a Skeleton Pose node."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez le squelette posé à la seconde entrée : la sortie d’un nœud Pose de squelette."
          }
        }
      }
    },
    "The second input is not a posed skeleton: it has no pose and inverse_bind point attributes. Connect the output of a Skeleton Pose node.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second input is not a posed skeleton: it has no pose and inverse_bind point attributes. Connect the output of a Skeleton Pose node."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seconde entrée n’est pas un squelette posé : elle n’a pas les attributs de point pose et inverse_bind. Branchez la sortie d’un nœud Pose de squelette."
          }
        }
      }
    },
    "The skeleton's pose or inverse_bind attribute does not hold a matrix for every joint.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The skeleton's pose or inverse_bind attribute does not hold a matrix for every joint."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attribut pose ou inverse_bind du squelette ne contient pas une matrice pour chaque articulation."
          }
        }
      }
    },
    "The mesh has no skin: it needs the point attributes skin_joint0 to skin_joint3 and skin_weight0 to skin_weight3. A rigged file gets them when Geometry Import reads it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mesh has no skin: it needs the point attributes skin_joint0 to skin_joint3 and skin_weight0 to skin_weight3. A rigged file gets them when Geometry Import reads it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le maillage n’a pas de skin : il lui faut les attributs de point skin_joint0 à skin_joint3 et skin_weight0 à skin_weight3. Un fichier rigué les reçoit quand Import de géométrie le lit."
          }
        }
      }
    },
    "Point %@ is skinned to joint %@, but the skeleton has %@ joints.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point %@ is skinned to joint %@, but the skeleton has %@ joints."
