artifacts

build-super
build-core/

# macOS
# The toolchain the bootstrap script installs. It is a few gigabytes of
# downloaded binaries, and the script rebuilds it from pinned archives.
toolchain/
# The bundle the installer stages.
stage/
dist/
# Scratch files from a build or a probe.
*.tmp
.probe-*
build-probe*/
# Sanitizer builds of the engine and the tests (AddressSanitizer, ThreadSanitizer).
build-asan/
build-tsan/
# The symlink the build agent points at its own build tree.
build-macos
# Logs and scratch files a tool leaves in the tree.
*.log
_git_*
# Editor lock files.
.!*
*~
*.orig
# Scratch left by the probe scripts and by the CMake qmlcache.
.tmpprobe*/
qmlcache_test.cpp.*
rn_a.txt

# Xcode user state and build products of the native app.
xcuserdata/
*.xcuserstate
DerivedData/

# Folder settings the macOS Finder writes.
.DS_Store
# Bytecode Python writes next to a script it imports.
__pycache__/
